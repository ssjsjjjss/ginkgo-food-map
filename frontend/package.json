{
  "name": "ginkgo-food-map-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "Ginkgo 美食地图 V2 前端",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts",
    "build": "vue-tsc -b && vite build --config config/vite.config.ts",
    "preview": "vite preview --config config/vite.config.ts",
    "typecheck": "vue-tsc -b",
    "lint": "eslint --config config/eslint.config.js .",
    "format": "prettier --config config/prettier.config.mjs --ignore-path config/.prettierignore --write \"src/**/*.{ts,vue,css}\" \"config/**/*.{js,mjs,ts,json}\" \"*.{json,md}\"",
    "format:check": "prettier --config config/prettier.config.mjs --ignore-path config/.prettierignore --check \"src/**/*.{ts,vue,css}\" \"config/**/*.{js,mjs,ts,json}\" \"*.{json,md}\"",
    "test": "vitest --config config/vite.config.ts run",
    "check": "npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
